# Fake, non-secret placeholder values so `npm test` can import App.jsx
# (which creates a Supabase client at module load) without needing real
# credentials. Vite loads this automatically when running tests (mode
# "test"). Safe to commit — these aren't real, nothing points at them.
VITE_SUPABASE_URL=https://test-placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=test-placeholder-anon-key
