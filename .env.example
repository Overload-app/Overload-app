# --- Anthropic (AI Coach, meal suggestions, photo analysis) ---
ANTHROPIC_API_KEY=your-key-from-console.anthropic.com

# --- Supabase (real accounts + database) ---
# Client-side (must keep the VITE_ prefix, these are safe to expose):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Server-side only (NEVER add a VITE_ prefix to these, they must stay secret):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (subscriptions) ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_YEARLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
